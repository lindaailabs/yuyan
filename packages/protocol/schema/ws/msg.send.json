{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuyan.im/protocol/ws/msg.send.json",
  "title": "msg.send request frame",
  "description": "发送消息。client_msg_id（UUID）仅本命令必填，服务端以此幂等去重",
  "type": "object",
  "properties": {
    "cmd": { "const": "msg.send" },
    "seq": { "type": "integer", "minimum": 1 },
    "data": {
      "type": "object",
      "properties": {
        "conv_id": { "type": "integer", "minimum": 1 },
        "content": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "required": ["conv_id", "content"],
      "additionalProperties": false
    },
    "client_msg_id": { "type": "string", "format": "uuid" }
  },
  "required": ["cmd", "seq", "data", "client_msg_id"],
  "additionalProperties": false
}
