{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuyan.im/protocol/ws/msg.ack.json",
  "title": "msg.ack frame",
  "description": "服务端对 msg.send 的确认，data 关联 client_msg_id 与服务端消息",
  "type": "object",
  "properties": {
    "cmd": { "const": "msg.ack" },
    "seq": { "type": "integer", "minimum": 1 },
    "data": {
      "type": "object",
      "properties": {
        "client_msg_id": { "type": "string", "format": "uuid" },
        "msg_id": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "integer", "minimum": 0 }
      },
      "required": ["client_msg_id", "msg_id", "created_at"],
      "additionalProperties": false
    }
  },
  "required": ["cmd", "seq", "data"],
  "additionalProperties": false
}
