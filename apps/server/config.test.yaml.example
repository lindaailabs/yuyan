# 本地开发环境配置模板（APP_ENV=test 时加载，或 CONFIG_FILE 指向本文件）。
# 用法：cp config.test.yaml.example config.test.yaml 后填入本地值（config.test.yaml 已被 .gitignore 忽略，不提交）。
# 本地调试接真实模型：把 ai_provider 设为 openai，并填下面三项。
# 模型 key 本地可直接内联明文（文件不提交）；若不想落盘，保持 ai_api_key: "${AI_API_KEY}" 并在启动前 export。
app_env: "test"
http_port: "8080"
log_level: "debug"
mysql_dsn: "root:yuyan123@tcp(127.0.0.1:3306)/yuyan?charset=utf8mb4&parseTime=True&loc=Local"
redis_addr: "127.0.0.1:6379"
ai_provider: "openai"
ai_base_url: "https://你的端点/v1"   # 模型 url
ai_api_key: "${AI_API_KEY}"          # 模型 key（本地可内联明文）
ai_model: "gpt-3.5-turbo"            # 模型 name
ai_timeout_ms: 8000
